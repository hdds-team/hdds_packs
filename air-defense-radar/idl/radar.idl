// HDDS Air Defense Radar Demo - IDL Type Definitions
// SPDX-License-Identifier: MIT

module radar {

    // Track classification status
    enum TrackStatus {
        UNKNOWN,
        FRIENDLY,
        HOSTILE,
        NEUTRAL
    };

    // Engagement state machine
    enum EngagementPhase {
        TRACKING,       // Target acquired, evaluating
        LAUNCHING,      // Missile in flight
        INTERCEPTING,   // Terminal phase
        COMPLETE        // Engagement finished
    };

    // Radar sweep position - published at ~90°/s (15 RPM)
    @appendable
    @topic
    struct RadarSweep {
        @key uint32 radar_id;
        float azimuth_deg;        // 0-360 current sweep angle
        float range_km;           // Maximum detection range
        uint64 timestamp_us;
    };

    // Aircraft track - detected targets
    @appendable
    @topic
    struct AircraftTrack {
        @key uint32 track_id;
        float x_km;               // East-West position (+ = East)
        float y_km;               // North-South position (+ = North)
        float altitude_m;         // Altitude in meters
        float heading_deg;        // 0-360, 0 = North
        float speed_kts;          // Speed in knots
        TrackStatus status;
        string<16> callsign;      // e.g., "UA-1234", "RU-5678"
        float rcs;                // Radar cross-section (dBsm)
        uint64 timestamp_us;
    };

    // SAM site status
    @appendable
    @topic
    struct SamSite {
        @key uint32 site_id;
        float x_km;               // Site position
        float y_km;
        float range_km;           // Engagement range
        uint8 missiles_ready;     // Available missiles
        uint8 missiles_total;     // Total capacity
        string<16> site_name;     // e.g., "PATRIOT-1", "S-300"
        boolean active;           // Radar on/off
    };

    // Active engagement
    @appendable
    @topic
    struct Engagement {
        @key uint32 engagement_id;
        uint32 site_id;           // Launching SAM site
        uint32 track_id;          // Target aircraft
        EngagementPhase phase;
        float missile_x_km;       // Missile position
        float missile_y_km;
        float missile_alt_m;
        float intercept_x_km;     // Predicted intercept point
        float intercept_y_km;
        float time_to_intercept_s;
        uint64 timestamp_us;
    };

    // Engagement result
    @appendable
    @topic
    struct EngagementResult {
        uint32 engagement_id;
        uint32 track_id;
        uint32 site_id;
        boolean success;          // true = kill, false = miss
        string<64> details;       // "Target destroyed", "Missile missed", etc.
        uint64 timestamp_us;
    };

    // Radar alert - threat warnings
    @appendable
    @topic
    struct RadarAlert {
        @key uint32 alert_id;
        uint32 track_id;          // Related track (if any)
        string<32> alert_type;    // "NEW_HOSTILE", "ENTERING_RANGE", etc.
        string<128> message;
        uint8 priority;           // 0=info, 1=warning, 2=critical
        uint64 timestamp_us;
    };

};
