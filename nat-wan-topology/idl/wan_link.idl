//
// WAN Link IDL - NAT Traversal Topology Demo
// Generate: hddsgen gen rust idl/wan_link.idl -o wan-types/src/generated.rs

@topic
struct SiteHeartbeat {
    @key string site_name;
    string public_ip;
    int32_t public_port;
    string nat_type;
    boolean using_relay;
    double rtt_ms;
    int64_t timestamp_ns;
};

@topic
struct SiteMessage {
    @key int64_t seq;
    string from_site;
    string to_site;
    int32_t payload_size;
    int64_t sent_ns;
    int64_t received_ns;
};

@topic
struct IceCandidate {
    @key string candidate_id;
    string candidate_type;
    string address;
    int32_t port;
    int32_t priority;
    string site_name;
};
